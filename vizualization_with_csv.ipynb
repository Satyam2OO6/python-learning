   "source": [
    "from bokeh.plotting import figure\n",
    "from bokeh.io import output_file, show\n",
    "import pandas as pd\n",
    "df=pd.read_csv(\"data.csv\")\n",
    "\n",
    "x = df[\"x\"]\n",
    "y = df[\"y\"]\n",
    "\n",
    "output_file(\"line_from_csv.html\")\n",
    "\n",
    "f = figure()\n",
    "f.line(x, y)\n",
    "\n",
    "show(f)"
   ]
